# Copia este archivo a .env en la raíz del repo (cp deploy/env.example .env) y rellénalo. NO se versiona.

# Nombre público de la app (su DNS debe apuntar al servidor). Caddy le pone HTTPS solo.
DOMINIO=autos.midominio.com

# Hora local de la sync diaria programada y de las copias de seguridad
TZ=Europe/Berlin

# Informe de IA de «Analizar rentabilidad» y de las revisiones (opcional). Pon UNA de las dos claves.
# La clave es del servidor y la usan todos los usuarios.
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
